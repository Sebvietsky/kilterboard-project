meta {
  name: Logout
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/logout
  body: none
  auth: inherit
}

script:post-response {
  // 204 : le refresh token est supprimé côté serveur, les deux tokens locaux
  // ne servent plus.
  if (res.status === 204) {
    bru.setEnvVar("accessToken", "");
    bru.setEnvVar("refreshToken", "");
  }
}
