meta {
  name: Mine
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/playlists/me
  body: none
  auth: inherit
}

params:query {
  ~boulderId: {{boulderId}}
}

docs {
  Playlists de l'utilisateur connecté.

  Avec `boulderId` (désactivé par défaut), chaque playlist porte en plus
  `containsBoulder` : c'est ce que lit la feuille « Add to playlist » du mobile.
}
