// ============================================================
// KILTERBOARD — Prisma Schema
//
// Domaines principaux :
//   - Utilisateurs & social    : User, UserFollow
//   - Matériel                 : BoardLayout, BoardSize, Board, Hold, HoldLed, Angle
//   - Blocs                    : Boulder, BoulderHold, BoulderTag, Tag, Grade
//   - Activité grimpe          : BoardSession, Ascent, AscentNote, AscentNoteLike
//   - Collections              : Playlist, PlaylistBoulder
// ============================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "nodejs"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// UTILISATEURS & SOCIAL
// ============================================================

// Compte grimpeur. Contient le profil public (avatar, bio, pays),
// les préférences (système de cotation) et la progression (xp/level).
// Le mot de passe est stocké sous forme de hash — jamais en clair.
model User {
  id           Int     @id @default(autoincrement())
  username     String  @unique @db.VarChar(50)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash")
  avatarUrl    String? @map("avatar_url")
  bio          String?
  country      String? @db.VarChar(100)

  // Rôle d'accès : USER pour les grimpeurs, ADMIN pour la modération
  role Role @default(USER)

  // Système de cotation préféré de l'utilisateur (V-scale ou Fontainebleau)
  gradeSystem GradeSystem @default(FONT_SCALE)

  // Si false, le profil est masqué des autres utilisateurs
  isPublic Boolean @default(true) @map("is_public")

  // Points d'expérience et niveau — calculés à partir des ascensions
  xpPoints Int @default(0) @map("xp_points")
  level    Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  boulders        Boulder[]
  boardSessions   BoardSession[]
  ascents         Ascent[]
  ascentNotes     AscentNote[]
  ascentNoteLikes AscentNoteLike[]

  // Relation auto-référentielle pour le système de suivi social.
  // followedBy = les gens qui suivent cet utilisateur (ses followers)
  // follows    = les gens que cet utilisateur suit
  followedBy UserFollow[] @relation("FollowingRelation")
  follows    UserFollow[] @relation("FollowerRelation")

  playlists     Playlist[]
  boulderLikes  BoulderLike[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Relation de suivi entre deux utilisateurs (follower → following).
// Clé composite (followerId, followingId) : un utilisateur ne peut suivre
// une même personne qu'une seule fois.
model UserFollow {
  followerId  Int      @map("follower_id")
  follower    User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  followingId Int      @map("following_id")
  following   User     @relation("FollowingRelation", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([followerId, followingId])
  @@map("user_follows")
}

// ============================================================
// MATÉRIEL — BOARD & PRISES
// ============================================================

// Modèle de planche (ex. Kilter Board Original), toutes tailles confondues.
// Sert de référence partagée entre les tailles (BoardSize), les prises (Hold),
// les blocs (Boulder) et les installations physiques (Board).
model BoardLayout {
  id           Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(100)
  manufacturer String? @db.VarChar(100)

  // Les dimensions dépendent de la taille (BoardSize), pas du layout
  description String?

  boulders Boulder[]
  holds    Hold[]
  boards   Board[]
  sizes    BoardSize[]

  @@map("board_layouts")
}

// Taille d'une planche pour un layout (ex. "12 x 12 with kickboard").
// Une taille est un rectangle (edge_*) sur la grille commune des prises du layout,
// et fixe la position LED de chaque prise (HoldLed).
// kilterSizeId : id Kilter de la taille (board_product_sizes), qui sert à l'import.
model BoardSize {
  id           Int         @id @default(autoincrement())
  layout       BoardLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId     Int         @map("layout_id")
  kilterSizeId Int         @map("kilter_size_id")
  name         String      @db.VarChar(100)

  edgeLeft   Int @map("edge_left")
  edgeRight  Int @map("edge_right")
  edgeBottom Int @map("edge_bottom")
  edgeTop    Int @map("edge_top")

  leds   HoldLed[]
  boards Board[]

  @@unique([layoutId, kilterSizeId])
  @@unique([layoutId, name])
  @@map("board_sizes")
}

// Installation physique d'une planche dans une salle ou chez un particulier.
// Un Board référence un BoardLayout : plusieurs boards peuvent partager le même layout.
// boardId est nullable sur BoardSession : on peut grimper sans board référencé.
model Board {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(100)
  gymName String? @map("gym_name") @db.VarChar(150)
  country String? @db.VarChar(100)
  city    String? @db.VarChar(100)

  // Coordonnées GPS pour localiser la salle sur une carte
  latitude  Decimal?
  longitude Decimal?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  layoutId    Int         @map("layout_id")
  boardLayout BoardLayout @relation(fields: [layoutId], references: [id], onDelete: Restrict)

  // La taille fixe les positions LED : une mauvaise taille allume les mauvaises prises.
  // Elle doit appartenir au même layout que la board (vérifié par le service, pas par la base).
  sizeId Int       @map("size_id")
  size   BoardSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  boardSessions BoardSession[]

  @@map("boards")
}

// Prise posée sur un layout : un placement Kilter (un trou + un set).
// La position (x, y) reprend les coordonnées Kilter du trou, communes à toutes les tailles.
// L'id reste le nôtre : boulder_holds n'en dépend pas, et l'id Kilter n'est unique que par marque.
model Hold {
  id       Int         @id @default(autoincrement())
  layout   BoardLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  layoutId Int         @map("layout_id")

  // Id Kilter du placement (board_placements), qui sert à l'import et à la lecture des blocs Kilter
  kilterPlacementId Int @map("kilter_placement_id")

  // Nom Kilter du trou (ex. "18,17", "1,KB1" pour le kickboard)
  holdCode String  @map("hold_code") @db.VarChar(20)
  set      HoldSet

  x Int
  y Int

  boulderHolds BoulderHold[]
  leds         HoldLed[]

  @@unique([layoutId, holdCode])
  @@unique([layoutId, kilterPlacementId])
  @@map("holds")
}

// Position LED d'une prise pour une taille de planche.
// Une prise sans ligne pour une taille est hors du cadre de cette taille.
// UNIQUE(sizeId, position) : une LED n'éclaire qu'une prise.
model HoldLed {
  hold     Hold      @relation(fields: [holdId], references: [id], onDelete: Cascade)
  holdId   Int       @map("hold_id")
  size     BoardSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  sizeId   Int       @map("size_id")
  position Int

  @@id([holdId, sizeId])
  @@unique([sizeId, position])
  @@map("hold_leds")
}

// Angle d'inclinaison de la planche en degrés.
// Table de référence : les valeurs sont prédéfinies (ex. 20°, 40°).
model Angle {
  id           Int     @id @default(autoincrement())
  valueDegrees Int     @unique @map("value_degrees")
  label        String? @db.VarChar(50) // ex. "Vertical", "Overhang"

  boulders         Boulder[]
  boulderAngles    BoulderAngle[]
  ascents          Ascent[]
  boulderLikes     BoulderLike[]
  playlistBoulders PlaylistBoulder[]

  @@map("angles")
}

// ============================================================
// BLOCS (PROBLÈMES D'ESCALADE)
// ============================================================

// Table de référence des cotations, double-indexée V-scale et Fontainebleau.
// `rank` permet d'ordonner les grades sans dépendre du format texte.
// Utilisée à deux endroits : cotation officielle d'un bloc + grade ressenti d'une ascension.
//
// Une ligne par cotation Font, l'échelle la plus fine : 6a et 6a+ sont deux
// lignes, toutes deux V3. Le V n'est donc pas unique. `rank` reprend le
// `difficulty` de Kilter (`board_difficulty_grades`), ce qui rend l'import
// direct. Seules les cotations listées par Kilter (4a à 8c+) existent ici.
model Grade {
  id        Int    @id @default(autoincrement())
  vScale    String @db.VarChar(5) // ex. "V5"
  fontScale String @unique @db.VarChar(5) // ex. "6c+"
  rank      Int    @unique // `difficulty` Kilter, croissant avec la difficulté

  boulders          Boulder[]      @relation("BoulderGrade")
  boulderAngles     BoulderAngle[] @relation("BoulderAngleGrade")
  boulderBaseAngles BoulderAngle[] @relation("BoulderAngleBaseGrade")
  ascents           Ascent[]       @relation("AscentFeltGrade")

  @@map("grades")
}

// Problème d'escalade créé par un utilisateur sur un layout à un angle donné.
// `isDraft` permet de sauvegarder un bloc sans le publier.
// `isPublic` contrôle la visibilité (profils privés ou blocs non partagés).
// onDelete: Restrict sur grade/layout/angle — on ne peut pas supprimer
// une référence tant que des blocs y sont rattachés.
model Boulder {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(150)
  description String?

  grade     Grade       @relation("BoulderGrade", fields: [gradeId], references: [id], onDelete: Restrict)
  gradeId   Int         @map("grade_id")
  creator   User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId Int         @map("creator_id")
  layout    BoardLayout @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  layoutId  Int         @map("layout_id")
  angle     Angle       @relation(fields: [angleId], references: [id], onDelete: Restrict)
  angleId   Int         @map("angle_id")

  isPublic  Boolean  @default(false) @map("is_public") // false par défaut car isDraft = true
  isDraft   Boolean  @default(true) @map("is_draft") // true par défaut -> false dès la création du boulder
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  boulderHolds     BoulderHold[]
  boulderTags      BoulderTag[]
  boulderAngles    BoulderAngle[]
  ascents          Ascent[]
  ascentNotes      AscentNote[]
  playlistBoulders PlaylistBoulder[]
  likes            BoulderLike[]

  @@map("boulders")
}

// Un bloc à une inclinaison : « le même bloc à une autre inclinaison est un
// autre bloc ». Association entre Boulder et Angle, identifiée par le couple
// (boulderId, angleId) et porteuse de la cotation effective à cette inclinaison.
//
// Une ligne par inclinaison de la table `angles`, toutes créées avec le bloc :
// les ascensions, favoris et entrées de playlist y pointent par une clé
// étrangère composée, qui exige que la ligne existe déjà.
//
// `baseGradeId` : cotation de départ à cette inclinaison, s'il y en a une.
// Celle du créateur à son inclinaison ; pour un bloc importé, celle de Kilter à
// chaque inclinaison où il a des statistiques.
// `gradeId` : cotation effective. La cotation de départ jusqu'au seuil de
// votes, puis la médiane des votes ; sans cotation de départ, null tant que
// personne n'y a envoyé le bloc. `votesCount` : un vote = le grade ressenti du
// premier envoi d'un grimpeur à cette inclinaison. « Estimée » ne se stocke
// pas, elle se déduit (peu de votes, sans cotation de départ).
// La cotation et l'inclinaison du créateur restent sur `boulders`, en référence.
model BoulderAngle {
  boulderId   Int     @map("boulder_id")
  boulder     Boulder @relation(fields: [boulderId], references: [id], onDelete: Cascade)
  angleId     Int     @map("angle_id")
  angle       Angle   @relation(fields: [angleId], references: [id], onDelete: Restrict)
  // Cotation effective : résultat calculé par recomputeAngleGrade, jamais
  // écrit à la main (src/boulders/community-grade.ts).
  gradeId     Int?    @map("grade_id")
  grade       Grade?  @relation("BoulderAngleGrade", fields: [gradeId], references: [id], onDelete: Restrict)
  // Cotation de départ à cette inclinaison, source du calcul : celle du
  // créateur à son inclinaison, celle de Kilter pour un bloc importé.
  baseGradeId Int?    @map("base_grade_id")
  baseGrade   Grade?  @relation("BoulderAngleBaseGrade", fields: [baseGradeId], references: [id], onDelete: Restrict)
  votesCount  Int     @default(0) @map("votes_count")

  ascents          Ascent[]
  likes            BoulderLike[]
  playlistBoulders PlaylistBoulder[]

  @@id([boulderId, angleId])
  @@map("boulder_angles")
}

// Table de jonction entre un bloc et ses prises.
// Clé composite (boulderId, holdId) : une prise ne peut apparaître qu'une fois par bloc.
// `role` définit le rôle de la prise dans le mouvement (départ, main, pied, top).
model BoulderHold {
  boulder   Boulder  @relation(fields: [boulderId], references: [id], onDelete: Cascade)
  boulderId Int      @map("boulder_id")
  hold      Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  holdId    Int      @map("hold_id")
  role      HoldRole

  @@id([boulderId, holdId])
  @@map("boulder_holds")
}

// Tag de catégorisation (ex. "crimp", "dynamic", "coordination").
// `slug` : version URL-friendly du nom, utilisée pour les filtres côté API.
model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(50)
  slug        String       @unique @db.VarChar(50)
  boulderTags BoulderTag[]

  @@map("tags")
}

// Table de jonction Boulder ↔ Tag.
// onDelete: Restrict sur Tag : on ne peut pas supprimer un tag encore utilisé.
model BoulderTag {
  boulder   Boulder @relation(fields: [boulderId], references: [id], onDelete: Cascade)
  boulderId Int     @map("boulder_id")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  tagId     Int     @map("tag_id")

  @@id([boulderId, tagId])
  @@map("boulder_tags")
}

// ============================================================
// ACTIVITÉ DE GRIMPE
// ============================================================

// Session de grimpe d'un utilisateur sur une planche.
// Règle métier : endedAt IS NULL = session active.
// Un utilisateur ne peut avoir qu'une seule session active à la fois —
// cette contrainte est enforced dans SessionsService + par @@unique avec condition
// boardId est nullable : on peut logger une session sans board référencé.
model BoardSession {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  boardId Int?   @map("board_id")
  board   Board? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  title     String?   @db.VarChar(100)
  note      String?
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz // NULL = session en cours

  // Si true, la session est visible sur le feed des followers
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  entries SessionEntry[]

  @@unique([userId], where: { endedAt: null }, map: "board_sessions_one_active_per_user")
  @@map("board_sessions")
}

// Un passage sur un bloc pendant une session. Une ligne par log, jamais
// modifiée : c'est le journal dont on tire le compte rendu de la session.
//
// Table distincte et non une colonne `session_id` sur Ascent : une ascension
// est UNE ligne par bloc (un projet se met à jour par PATCH), alors qu'un même
// bloc peut être travaillé dans plusieurs sessions, et plusieurs fois dans la
// même. Avec une colonne, le projet quittait la session précédente à chaque
// nouvelle séance.
//
// Un log hors session n'écrit rien ici : `sessionId` est obligatoire.
model SessionEntry {
  id        Int          @id @default(autoincrement())
  sessionId Int          @map("session_id")
  session   BoardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ascentId  Int          @map("ascent_id")
  ascent    Ascent       @relation(fields: [ascentId], references: [id], onDelete: Cascade)

  // Statut de l'ascension À L'ISSUE de ce passage : PROJECT tant que le bloc
  // résiste, SENT le jour où il tombe. Figé ici, car Ascent.status évolue.
  status   AscentStatus
  // Essais de CE passage, pas le cumul (qui reste sur Ascent.attemptsCount).
  attempts Int          @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId, createdAt])
  @@index([ascentId])
  @@map("session_entries")
}

// Enregistrement d'une tentative ou d'une réussite sur un bloc.
// `status` : FLASH (premier essai), SENT (réussi), PROJECT (en cours), REPEAT (re-grimpe).
// `feltGrade` : cotation ressentie par le grimpeur — obligatoire pour SENT/FLASH.
// `sendDate` : date d'envoi, null si status = PROJECT.
// sessionId nullable : une ascension peut être enregistrée hors session.
model Ascent {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boulderId Int     @map("boulder_id")
  boulder   Boulder @relation(fields: [boulderId], references: [id], onDelete: Cascade)

  // Inclinaison à laquelle le bloc a été grimpé, pas celle de sa création :
  // le même bloc à 40° et à 45° donne deux réussites distinctes. Toujours
  // envoyée par le client, jamais devinée : sans BLE, seul l'écran la connaît.
  angleId      Int          @map("angle_id")
  angle        Angle        @relation(fields: [angleId], references: [id], onDelete: Restrict)
  // Le bloc à cette inclinaison : la clé composée garantit que la ligne existe,
  // et donne accès à la cotation effective.
  boulderAngle BoulderAngle @relation(fields: [boulderId, angleId], references: [boulderId, angleId], onDelete: Cascade)

  status        AscentStatus
  attemptsCount Int          @default(0) @map("attempts_count")
  sendDate      DateTime?    @map("send_date") @db.Timestamptz

  // Nombre de séances passées sur le bloc. Toute ascension en vaut au moins
  // une — celle qui la crée — d'où le défaut à 1. Seul un projet le voit
  // grandir : chaque « Save » depuis l'onglet In Project l'incrémente.
  // Un simple compteur plutôt qu'une table ProjectSession : les maquettes
  // n'affichent qu'un total, et une table ne se justifierait que pour garder
  // l'historique par séance (date, essais et note de chacune).
  sessionsCount Int @default(1) @map("sessions_count")

  // Grade ressenti = le vote du grimpeur pour la cotation du bloc à cette
  // inclinaison. Donné une seule fois, au premier envoi (ou à la complétion
  // du projet) : l'index partiel ci-dessous le garantit en base.
  feltGrade   Grade? @relation("AscentFeltGrade", fields: [feltGradeId], references: [id], onDelete: Restrict)
  feltGradeId Int?   @map("felt_grade_id")

  // Note de 1 à 5 sur la qualité du bloc, donnée par le grimpeur
  rating     Int?
  wasProject Boolean  @default(false) @map("was_project")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ascentNotes    AscentNote[]
  sessionEntries SessionEntry[]

  // Un seul grade ressenti par grimpeur, par bloc et par inclinaison.
  @@unique([userId, boulderId, angleId], where: { feltGradeId: { not: null } }, map: "ascents_one_felt_grade_per_user_boulder_angle")
  @@map("ascents")
}

// Commentaire associé à une ascension sur un bloc précis.
// Règle métier : PUBLIC uniquement pour SENT/FLASH (premier envoi).
// Pour REPEAT, seul PRIVATE est autorisé — enforced dans AscentNotesService.
// boulderId est dénormalisé ici pour faciliter les requêtes "tous les commentaires d'un bloc".
model AscentNote {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  boulderId Int     @map("boulder_id")
  boulder   Boulder @relation(fields: [boulderId], references: [id], onDelete: Restrict)
  ascentId  Int     @map("ascent_id")
  ascent    Ascent  @relation(fields: [ascentId], references: [id], onDelete: Cascade)

  content    String
  visibility Visibility

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  ascentNoteLikes AscentNoteLike[]

  @@map("ascent_notes")
}

// Like sur un commentaire d'ascension.
// Clé composite (userId, ascentNoteId) : un user ne peut liker qu'une fois.
model AscentNoteLike {
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ascentNoteId Int        @map("ascent_note_id")
  ascentNote   AscentNote @relation(fields: [ascentNoteId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, ascentNoteId])
  @@map("ascent_note_likes")
}

// ============================================================
// COLLECTIONS
// ============================================================

// Liste de blocs créée par un utilisateur (ex. "Mes projets", "Circuit du mardi").
// Les favoris n'en sont pas une : ils ont leur propre table (BoulderLike).
// Privée par défaut — isPublic = true pour partager avec la communauté.
model Playlist {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  playlistBoulders PlaylistBoulder[]

  @@map("playlists")
}

// Table de jonction Playlist ↔ Boulder, avec position optionnelle pour l'ordre.
// Clé composite (boulderId, playlistId, angleId) : un bloc n'apparaît qu'une fois
// par playlist et par inclinaison. Le même bloc à deux inclinaisons fait deux entrées.
model PlaylistBoulder {
  boulder      Boulder      @relation(fields: [boulderId], references: [id], onDelete: Cascade)
  boulderId    Int          @map("boulder_id")
  playlist     Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  playlistId   Int          @map("playlist_id")
  angle        Angle        @relation(fields: [angleId], references: [id], onDelete: Restrict)
  angleId      Int          @map("angle_id")
  // Le bloc à cette inclinaison (voir BoulderAngle).
  boulderAngle BoulderAngle @relation(fields: [boulderId, angleId], references: [boulderId, angleId], onDelete: Cascade)
  position     Int? // Ordre d'affichage dans la playlist, null = non ordonné
  addedAt      DateTime     @default(now()) @map("added_at") @db.Timestamptz

  @@id([boulderId, playlistId, angleId])
  @@map("playlist_boulders")
}

// Favori : un utilisateur like un bloc.
// Clé composite (userId, boulderId, angleId) : un user like un bloc une fois par
// inclinaison. Le même bloc liké à deux inclinaisons fait deux favoris.
// `createdAt` sert à trier les blocs likés, du plus récent au plus ancien.
model BoulderLike {
  userId       Int          @map("user_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  boulderId    Int          @map("boulder_id")
  boulder      Boulder      @relation(fields: [boulderId], references: [id], onDelete: Cascade)
  angleId      Int          @map("angle_id")
  angle        Angle        @relation(fields: [angleId], references: [id], onDelete: Restrict)
  // Le bloc à cette inclinaison (voir BoulderAngle).
  boulderAngle BoulderAngle @relation(fields: [boulderId, angleId], references: [boulderId, angleId], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@id([userId, boulderId, angleId])
  @@map("boulder_likes")
}

// Stockage du refresh token
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("refresh_tokens")
}

// ============================================================
// ENUMS
// ============================================================

// Rôle d'accès d'un utilisateur dans l'application
enum Role {
  USER // Grimpeur standard
  ADMIN // Accès administration et modération
}

// Visibilité d'un commentaire d'ascension
enum Visibility {
  PUBLIC // Visible par tous (feed, page du bloc)
  PRIVATE // Visible uniquement par l'auteur
}

// Système de cotation préféré de l'utilisateur pour l'affichage
enum GradeSystem {
  V_SCALE // Système américain (V0, V1… V17)
  FONT_SCALE // Système Fontainebleau (4a, 6b+… 9a)
}

// Rôle d'une prise dans la définition d'un bloc
enum HoldRole {
  START // Prise de départ (mains au départ)
  HAND // Prise de main intermédiaire
  FOOT // Prise de pied uniquement
  FINISH // Prise de finition (top)
}

// Jeu de prises Kilter auquel appartient une prise (board_sets)
enum HoldSet {
  BOLT_ONS // Set 1
  SCREW_ONS // Set 20
}

// Statut d'une ascension
enum AscentStatus {
  FLASH // Réussi du premier coup, sans beta préalable
  SENT // Réussi après plusieurs essais
  PROJECT // En cours, pas encore réussi
  REPEAT // Re-grimpe d'un bloc déjà envoyé
}
